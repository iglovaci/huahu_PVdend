
ncell=1
objref random_segment1,random_location1, random_I
random_segment1= new Random (RNG_seed)
random_location1=new Random (RNG_seed)
random_I=new Random(RNG_seed)
basal_Compart=dend_number


objref Poisson_input[ncell][200], Poisson_synapse[ncell][200], Poisson_synapse_net[ncell][200]//each cell has 100 excitatory synapses in distal basal dendrites.
objref basal_segment, basal_location
basal_segment=new Vector(200)
basal_location=new Vector(200)
for a1=0, 199 {access soma
			 distance(0, 0.5)
			 basal_segment.x[a1] = random_segment1.discunif(0, basal_Compart-1)
			 basal_location.x[a1] = random_location1.discunif(1, 99)/100
			 access dend[basal_segment.x[a1]]
			 dis=distance (basal_location.x[a1])
								  
			 while ((dis<20)||(dis>100)) {	basal_segment.x[a1] = random_segment1.discunif(0, basal_Compart-1)
											basal_location.x[a1] = random_location1.discunif(1, 99)/100
											access dend[basal_segment.x[a1]]
											dis=distance (basal_location.x[a1])}
											
											
											
			 print dis
			}

print "sdddddddddddddddddddd"

for a1=0, ncell-1 {
				   access soma
				   distance(0, 0.5)
				   for b1=0, 99 {
								  //print a1*100+b1
								 // print "B1 =", b1, ", A1 = ", a1
								  access dend[basal_segment.x[b1]]
								  Poisson_synapse[a1][b1]= new Exp2Syn(basal_location.x[b1])
								  Poisson_synapse[a1][b1].e=0
								  Poisson_synapse[a1][b1].tau1=0.14
								  Poisson_synapse[a1][b1].tau2=0.77  
								  
								  access dend[basal_segment.x[b1]]
								  Poisson_input[a1][b1]= new NetStimm(0.5)
								  Poisson_input[a1][b1].number = 1e+100
								  Poisson_input[a1][b1].start = 0
								  Poisson_input[a1][b1].noise= 1 
								  Poisson_input[a1][b1].interval =1000/100
								  
								  
								  
								  
								  
								  Poisson_synapse_net[a1][b1]=new NetCon(Poisson_input[0][b1], Poisson_synapse[a1][b1], 0, 0.2, 0)
								  Poisson_synapse_net[a1][b1].weight=(5e-4)*1*0
								   
								  }
								 
								  }
					
objref Random_delay				

objref Poisson_input_i[ncell][100]
for a1=0, ncell-1 {for b1=0, 99{Poisson_input_i[a1][b1]= new Vector()}}



objref Drive_on_list, Drive_on_tag, Number_of_active_synpase_each_cell
Drive_on_list=new Vector(ncell,0)
Drive_on_tag=new Vector(ncell,0)
Number_of_active_synpase_each_cell=new Vector(ncell,0)

proc make_Poisson_input() {for (a1=0; a1<=ncell-1;a1=a1+1) {random_delay=100
														   print random_delay
											  //random_delay=random_I.normal(100,100*100*.5*.5)
                                              //while ((random_delay<0)||(random_delay>=200)) {random_delay=random_I.normal(100,100*100*.5*.5)}
											  for b1=0, 99 {Poisson_input[a1][b1].start=random_delay-random_delay+1}
											  Drive_on_list.x[a1]=random_delay/dt
											  Drive_on_tag.x[a1]=0
											  
											  Poisson_frequency = $1
											  print "tttt"
											  for b1=0, 99 {Poisson_input[a1][b1].interval=1000/Poisson_frequency
															 Poisson_synapse_net[a1][b1].weight=(5e-4)*1*0}
															}
														
											  Number_of_active_synpase_each_cell=new Vector(ncell,0)			
											  print "bbbb"
											  	
											  for b1=0, ncell-1 {random_active_synapse_number=random_I.normal(100, 100*100*0*0) 
															 while ((random_active_synapse_number<0)||(random_active_synapse_number>199)) {random_active_synapse_number=random_I.normal(200, 0)}
															 Number_of_active_synpase_each_cell.x[b1]=random_active_synapse_number
															 }
											  
											  print "cccc"
											  
											  }

proc activate_BC() {for a1=0,ncell-1{for b1=0, 99 {Poisson_synapse_net[a1][b1].weight=(5e-4)*1*1}}}
					  
proc deactivate_BC() {for a1=0,ncell-1{for b1=0, 99 {Poisson_synapse_net[a1][b1].weight=(5e-4)*1*0}}}		

					
objref Input_I
Input_I=new Vector()											  
proc run_simulation() { local i1
						for a1=0, ncell-1 {for b1=0, 99{Poisson_input_i[a1][b1]= new Vector()}}
						for a1=0, ncell-1 {for b1=0, 99{Poisson_input_i[a1][b1].record(&Poisson_synapse[a1][b1].i)}}
						
					    init()
				
					    total_duration=stoptime/dt
					    sample=0
						
						connection_on=0
						progress = 10
						
												
						while (sample<total_duration) {if ((sample>1000)&&(sample<11000))  {if (connection_on==0) {activate_BC() connection_on=1}}
													   if (sample>=11000){if (connection_on==1) {deactivate_BC()}}
						
						
				 
						fadvance() 
						sample=sample+1 
						if (sample>progress/100*total_duration) { print progress, "% progress" progress=progress+10}

						//print sample
						}
				
		 
		 Input_I=new Vector(Poisson_input_i[0][0].size,0)
		 
		 for b1=0, 99 {Input_I=Input_I.add(Poisson_input_i[0][b1])}
		  
		 I_input.x[drive]=Input_I.sum(1001, 11000)/10000
		 }
											  